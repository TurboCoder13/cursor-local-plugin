# Linux acceptance image: compile the plugin, then load it in the real CPA host.
FROM golang:1.27-bookworm@sha256:df4bb0305771186a85d0fd3a40f5c5da9af97ac8053d391ffce2c070817a20c6 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build make build check-go

FROM ubuntu:26.04@sha256:0e73b71479e7bc5f006bca872e25c3cd680dc052a0116f90d63ae363537db0dd
RUN apt-get update && apt-get install -y --no-install-recommends ruby=1:3.3build1 ruby-minitest=5.26.1-1 ca-certificates=20260816ubuntu0.26.04.1 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY --from=builder /src /src
RUN ruby tools/platform-test.rb
CMD ["ruby", "tools/host-check.rb", "--binary", "/host/cliproxyapi"]
