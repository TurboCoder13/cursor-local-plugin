# Linux acceptance image: compile the plugin, then load it in the real CPA host.
FROM golang:1.27-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build make build check-go

FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
RUN apt-get update && apt-get install -y --no-install-recommends ruby=1:3.2~ubuntu1 ruby-minitest=5.22.2-1 ca-certificates=20260601~24.04.1 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY --from=builder /src /src
RUN ruby tools/platform-test.rb
CMD ["ruby", "tools/host-check.rb", "--binary", "/host/cliproxyapi"]
